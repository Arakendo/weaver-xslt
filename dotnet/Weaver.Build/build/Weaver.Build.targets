<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Minimal MSBuild targets to integrate Weaver compile into BeforeBuild.
       This is a conservative scaffold and intentionally minimal. It is expected
       to be improved (diagnostics parsing, incrementality using sidecar deps,
       robust node resolution, cross-platform path handling) in follow-ups. -->

  <!-- Import this file by referencing the Weaver.Build package in a project.
       The package should include these files under build/ so MSBuild auto-imports them. -->

  <PropertyGroup>
    <!-- Location where the carrier/tooling will be expected. Weaver.Tool would
         place the CLI entrypoint under tools/weaver/ in the package layout. -->
    <WeaverToolCliPath>$(MSBuildThisFileDirectory)..\tools\weaver\weaver-xslt.js</WeaverToolCliPath>
  </PropertyGroup>

  <!-- Ensure the item exists even if consumer omitted it so targets don't fail. -->
  <ItemGroup>
    <WeaverStylesheet Include="@(WeaverStylesheet)" Condition="'@(WeaverStylesheet)' != ''" />
  </ItemGroup>

  <Target Name="ResolveWeaverInputs" BeforeTargets="BeforeBuild" Condition="'$(WeaverEnabled)' == 'true'">
    <Message Text="Weaver: resolving %(WeaverStylesheet.Identity) (WeaverEmit=$(WeaverEmit))" Importance="High" Condition="'@(WeaverStylesheet)' != ''" />
  </Target>

  <Target Name="CompileWeaverStylesheets" DependsOnTargets="ResolveWeaverInputs" BeforeTargets="BeforeBuild" Condition="'$(WeaverEnabled)' == 'true' and '@(WeaverStylesheet)' != ''">
    <!-- For each stylesheet invoke the CLI. This simple Exec-based approach is a scaffold.
         A production integration should call the carrier and parse a machine-readable
         diagnostics stream instead of relying on raw console output. -->
    <ItemGroup>
      <_WeaverToCompile Include="@(WeaverStylesheet)" />
    </ItemGroup>

    <Message Text="Weaver: compiling %(_WeaverToCompile.Identity) -> $(WeaverOutputDir)" Importance="High" />

    <Exec Command="&quot;$(WeaverNode)&quot; &quot;$(WeaverToolCliPath)&quot; compile &quot;%(_WeaverToCompile.Identity)&quot; --emit $(WeaverEmit) --outDir &quot;$(WeaverOutputDir)&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="WeaverExitCode" />
    </Exec>

    <!-- Fail the build on non-zero exit; future work: map diagnostics by reading a JSON stream -->
    <Error Condition="'$(WeaverExitCode)' != '0'" Text="Weaver compilation failed for %(_WeaverToCompile.Identity) (exit code $(WeaverExitCode)). See tool output for details." />

    <!-- Collect emitted artifacts for downstream copying/publishing -->
    <ItemGroup>
      <WeaverArtifact Include="$(WeaverOutputDir)**\*.*" />
    </ItemGroup>

    <!-- Optionally copy to publish/output dir when enabled -->
    <Copy Condition="'$(WeaverCopyToOutput)' == 'true'" SourceFiles="@(WeaverArtifact)" DestinationFiles="@(WeaverArtifact->'$(OutputPath)weaver\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />

    <Message Text="Weaver: compiled %(_WeaverToCompile.Identity). Artifacts: @(WeaverArtifact)" Importance="Normal" />
  </Target>

  <!-- Hook into Publish to ensure artifacts are included when publishing the app -->
  <Target Name="WeaverCollectForPublish" AfterTargets="Publish" Condition="'$(WeaverEnabled)' == 'true' and '$(WeaverCopyToOutput)' == 'true'">
    <Message Text="Weaver: publish-time artifacts should now be under $(OutputPath)weaver\" Importance="Normal" />
  </Target>

</Project>
