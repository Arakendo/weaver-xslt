<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Minimal MSBuild targets to integrate Weaver compile into BeforeBuild.
       This is a conservative scaffold and intentionally minimal. It is expected
       to be improved (diagnostics parsing, incrementality using sidecar deps,
       robust node resolution, cross-platform path handling) in follow-ups. -->

  <!-- Import this file by referencing the Weaver.Build package in a project.
       The package should include these files under build/ so MSBuild auto-imports them. -->

  <PropertyGroup>
    <!-- Location where the carrier/tooling will be expected. Weaver.Tool would
         place the CLI entrypoint under tools/weaver/ in the package layout. -->
    <!-- Prefer the locally built JS CLI (dist/cli.js) when present in the repo. -->
    <_LocalDistCli>$(MSBuildThisFileDirectory)..\..\..\dist\cli.js</_LocalDistCli>
    <WeaverToolCliPath Condition="Exists('$(_LocalDistCli)')">$(_LocalDistCli)</WeaverToolCliPath>
    <WeaverToolCliPath Condition="!Exists('$(_LocalDistCli)')">$(MSBuildThisFileDirectory)..\tools\weaver\weaver-xslt.js</WeaverToolCliPath>
  </PropertyGroup>

  <!-- Ensure the item exists even if consumer omitted it so targets don't fail. -->
  <ItemGroup>
    <WeaverStylesheet Include="@(WeaverStylesheet)" Condition="'@(WeaverStylesheet)' != ''" />
  </ItemGroup>

  <Target Name="ResolveWeaverInputs" BeforeTargets="BeforeBuild" Condition="'$(WeaverEnabled)' == 'true' and ( '$(DesignTimeBuild)' != 'true' or '$(WeaverDesignTimeEnabled)' == 'true' ) and ( '$(WeaverDisableFile)' == '' or !Exists('$(WeaverDisableFile)') )">
    <!-- Debug: print the list of WeaverStylesheet items available to this target -->
    <Message Text="Weaver: item @(WeaverStylesheet)" Importance="High" />
    <Message Text="Weaver: resolving %(WeaverStylesheet.Identity) (WeaverEmit=$(WeaverEmit))" Importance="High" Condition="'@(WeaverStylesheet)' != ''" />

    <!-- Build an item list of inputs (stylesheet plus any .deps files' contents) so the compile target can be incremental -->
    <ItemGroup>
      <!-- Add the stylesheet file itself as an input -->
      <WeaverInputs Include="@(WeaverStylesheet->'$(MSBuildProjectDirectory)/%(Identity)')" />
      <!-- Collect any existing .deps sidecars for reading dependency lines -->
      <_WeaverDepsFiles Include="$(MSBuildProjectDirectory)/%(WeaverStylesheet.Identity).deps" Condition="Exists('$(MSBuildProjectDirectory)/%(WeaverStylesheet.Identity).deps')" />
    </ItemGroup>

    <!-- Read all dependency files (if any) and append their lines to WeaverInputs -->
    <ReadLinesFromFile File="@(_WeaverDepsFiles)" Condition="@(_WeaverDepsFiles) != ''">
      <Output TaskParameter="Lines" ItemName="WeaverInputs" />
    </ReadLinesFromFile>

    <!-- Precompute the outputs (possible primary artifacts) to enable Inputs/Outputs evaluation. -->
    <ItemGroup>
      <WeaverOutputs Include="$(MSBuildProjectDirectory)/%(WeaverStylesheet.Identity).bundle.js;$(MSBuildProjectDirectory)/%(WeaverStylesheet.Identity).js;$(MSBuildProjectDirectory)/%(WeaverStylesheet.Identity).ts" />
    </ItemGroup>
  </Target>

  <Target Name="CompileWeaverStylesheets" DependsOnTargets="ResolveWeaverInputs" BeforeTargets="BeforeBuild" Inputs="@(WeaverInputs)" Outputs="@(WeaverOutputs)" Condition="'$(WeaverEnabled)' == 'true' and '@(WeaverStylesheet)' != ''">
    <PropertyGroup>
      <!-- Helper to pass fail-on-diagnostics flag to the CLI when requested -->
      <WeaverCliFailFlag Condition="'$(WeaverFailOnDiagnostics)' == 'true'">--fail-on-diagnostics true</WeaverCliFailFlag>
    </PropertyGroup>
    <!-- For each stylesheet invoke the CLI. This simple Exec-based approach is a scaffold.
         A production integration should call the carrier and parse a machine-readable
         diagnostics stream instead of relying on raw console output. -->
    <ItemGroup>
      <_WeaverToCompile Include="@(WeaverStylesheet)" />
    </ItemGroup>

    <Message Text="Weaver: compiling %(_WeaverToCompile.Identity) -> $(WeaverOutputDir)" Importance="High" />

    <Exec Command="&quot;$(WeaverNode)&quot; &quot;$(WeaverToolCliPath)&quot; compile &quot;%(_WeaverToCompile.Identity)&quot; --emit $(WeaverEmit) --diagnostics json --diagnostics-out &quot;$(WeaverOutputDir)%(_WeaverToCompile.Filename).diagnostics.json&quot; $(WeaverCliFailFlag)" WorkingDirectory="$(MSBuildProjectDirectory)" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="WeaverExitCode" />
    </Exec>

    <!-- Emit structured diagnostics into MSBuild from any JSON diagnostics files produced by the CLI. -->
    <ItemGroup>
      <_WeaverJsonDiagnostics Include="$(WeaverOutputDir)%(_WeaverToCompile.Filename).diagnostics.json" Condition="Exists('$(WeaverOutputDir)%(_WeaverToCompile.Filename).diagnostics.json')" />
    </ItemGroup>

    <!-- Inline MSBuild task to parse diagnostics JSON and emit MSBuild warnings/errors so IDEs can pick them up. -->
    <UsingTask
      TaskName="WeaverEmitDiagnostics"
      TaskFactory="CodeTaskFactory"
      AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
      <ParameterGroup>
        <DiagnosticsFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      </ParameterGroup>
      <Task>
        <Reference Include="System.Text.Json" />
        <Code Type="Class" Language="cs">
<![CDATA[
using System;
using System.IO;
using System.Text.Json;
using Microsoft.Build.Framework;
using Microsoft.Build.Utilities;

public class WeaverEmitDiagnostics : Task
{
    [Required]
    public ITaskItem[] DiagnosticsFiles { get; set; }

    public override bool Execute()
    {
        if (DiagnosticsFiles == null || DiagnosticsFiles.Length == 0)
        {
            return true;
        }

        foreach (var item in DiagnosticsFiles)
        {
            var path = item.ItemSpec;
            try
            {
                var text = File.ReadAllText(path);
                using var doc = JsonDocument.Parse(text);
                var root = doc.RootElement;

                // Try to get the provided source base path
                string sourceBase = null;
                if (root.TryGetProperty("source", out var sourceElem) && sourceElem.ValueKind == JsonValueKind.Object && sourceElem.TryGetProperty("path", out var sp))
                {
                    sourceBase = sp.GetString();
                }

                if (!root.TryGetProperty("diagnostics", out var diagnostics) || diagnostics.ValueKind != JsonValueKind.Array)
                {
                    continue;
                }

                foreach (var diag in diagnostics.EnumerateArray())
                {
                    var severity = diag.GetProperty("severity").GetString();
                    var code = diag.GetProperty("code").GetString();
                    var message = diag.GetProperty("message").GetString();

                    string file = null;
                    int line = 0;
                    int column = 0;

                    if (diag.TryGetProperty("primary", out var primary) && primary.ValueKind == JsonValueKind.Object)
                    {
                        if (primary.TryGetProperty("uri", out var uriValue) && uriValue.ValueKind == JsonValueKind.String)
                        {
                            file = uriValue.GetString();
                        }
                        if (primary.TryGetProperty("lineStart", out var lineV) && lineV.ValueKind == JsonValueKind.Number)
                        {
                            line = lineV.GetInt32();
                        }
                        if (primary.TryGetProperty("columnStart", out var colV) && colV.ValueKind == JsonValueKind.Number)
                        {
                            column = colV.GetInt32();
                        }
                    }

                    // If file is relative, try to resolve against sourceBase
                    if (!string.IsNullOrEmpty(file) && !Path.IsPathRooted(file) && !string.IsNullOrEmpty(sourceBase))
                    {
                        try
                        {
                            file = Path.GetFullPath(Path.Combine(Path.GetDirectoryName(sourceBase), file));
                        }
                        catch
                        {
                            // ignore resolution errors
                        }
                    }

                    // Default message format includes the diagnostic code to help mapping
                    var text = $"{message} ({code})";

                    if (string.Equals(severity, "error", StringComparison.OrdinalIgnoreCase))
                    {
                        if (!string.IsNullOrEmpty(file) && line > 0)
                        {
                            Log.LogError(null, code, null, file, line, column, 0, 0, text);
                        }
                        else
                        {
                            Log.LogError(text);
                        }
                    }
                    else
                    {
                        if (!string.IsNullOrEmpty(file) && line > 0)
                        {
                            Log.LogWarning(null, code, null, file, line, column, 0, 0, text);
                        }
                        else
                        {
                            Log.LogWarning(text);
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                Log.LogWarning($"Weaver: failed to parse diagnostics file {path}: {ex.Message}");
            }
        }

        return true;
    }
}
]]>
        </Code>
      </Task>
    </UsingTask>

    <WeaverEmitDiagnostics DiagnosticsFiles="@(_WeaverJsonDiagnostics)" Condition="@(_WeaverJsonDiagnostics) != ''" />

    <!-- Fail the build on non-zero exit; future work: map diagnostics by reading a JSON stream -->
    <Error Condition="'$(WeaverExitCode)' != '0'" Text="Weaver compilation failed for %(_WeaverToCompile.Identity) (exit code $(WeaverExitCode)). See tool output for details." />

    <!-- Collect emitted artifacts for downstream copying/publishing. The CLI emits artifacts next to
         the source stylesheet; copy them into the configured WeaverOutputDir so MSBuild can
         include them in publish/output. -->
    <ItemGroup>
      <WeaverArtifact Include="$(MSBuildProjectDirectory)/%(_WeaverToCompile.Identity).bundle.js" Condition="Exists('$(MSBuildProjectDirectory)/%(_WeaverToCompile.Identity).bundle.js')" />
      <WeaverArtifact Include="$(MSBuildProjectDirectory)/%(_WeaverToCompile.Identity).bundle.js.map" Condition="Exists('$(MSBuildProjectDirectory)/%(_WeaverToCompile.Identity).bundle.js.map')" />
      <WeaverArtifact Include="$(MSBuildProjectDirectory)/%(_WeaverToCompile.Identity).js" Condition="Exists('$(MSBuildProjectDirectory)/%(_WeaverToCompile.Identity).js')" />
      <WeaverArtifact Include="$(MSBuildProjectDirectory)/%(_WeaverToCompile.Identity).js.map" Condition="Exists('$(MSBuildProjectDirectory)/%(_WeaverToCompile.Identity).js.map')" />
      <WeaverArtifact Include="$(MSBuildProjectDirectory)/%(_WeaverToCompile.Identity).ts" Condition="Exists('$(MSBuildProjectDirectory)/%(_WeaverToCompile.Identity).ts')" />
      <WeaverArtifact Include="$(MSBuildProjectDirectory)/%(_WeaverToCompile.Identity).d.ts" Condition="Exists('$(MSBuildProjectDirectory)/%(_WeaverToCompile.Identity).d.ts')" />
      <WeaverArtifact Include="$(MSBuildProjectDirectory)/%(_WeaverToCompile.Identity).digest" Condition="Exists('$(MSBuildProjectDirectory)/%(_WeaverToCompile.Identity).digest')" />
      <WeaverArtifact Include="$(MSBuildProjectDirectory)/%(_WeaverToCompile.Identity).deps" Condition="Exists('$(MSBuildProjectDirectory)/%(_WeaverToCompile.Identity).deps')" />
      <WeaverArtifact Include="$(WeaverOutputDir)%(_WeaverToCompile.Filename).diagnostics.json" Condition="Exists('$(WeaverOutputDir)%(_WeaverToCompile.Filename).diagnostics.json')" />
    </ItemGroup>

    <!-- Optionally copy to publish/output dir when enabled -->
    <Copy Condition="'$(WeaverCopyToOutput)' == 'true'" SourceFiles="@(WeaverArtifact)" DestinationFiles="@(WeaverArtifact->'$(OutputPath)weaver\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />

    <Message Text="Weaver: compiled %(_WeaverToCompile.Identity). Artifacts: @(WeaverArtifact)" Importance="Normal" />
  </Target>

  <!-- Hook into Publish to ensure artifacts are included when publishing the app -->
  <Target Name="WeaverCollectForPublish" AfterTargets="Publish" Condition="'$(WeaverEnabled)' == 'true' and '$(WeaverCopyToOutput)' == 'true'">
    <Message Text="Weaver: publish-time artifacts should now be under $(OutputPath)weaver\" Importance="Normal" />
  </Target>

</Project>
