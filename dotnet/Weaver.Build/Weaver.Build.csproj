<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <Version>0.0.1</Version>

    <PackageId>Weaver.Build</PackageId>
    <Title>Weaver.Build</Title>
    <Description>MSBuild integration for compiling Weaver XSLT stylesheets during .NET build and publish.</Description>
    <Authors>Arakendo</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Arakendo/weaver-xslt</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Arakendo/weaver-xslt</PackageProjectUrl>
    <PackageTags>xslt;xpath;msbuild;dotnet;build</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Weaver.Tool\Weaver.Tool.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="build/Weaver.Build.props" Pack="true" PackagePath="build/Weaver.Build.props" />
    <None Include="build/Weaver.Build.targets" Pack="true" PackagePath="build/Weaver.Build.targets" />
    <None Include="tools/weaver/**" Pack="true" PackagePath="tools/weaver/" />
    <None Include="..\Weaver.Tool\bin\$(Configuration)\net8.0\Weaver.Tool*" Exclude="..\Weaver.Tool\bin\$(Configuration)\net8.0\*.pdb" Pack="true" PackagePath="tools/weaver/" />
    <None Include="..\..\dist\**\*.js;..\..\dist\**\*.json" Pack="true" PackagePath="tools/weaver/dist/" />

    <None Include="..\..\node_modules\@xmldom\xmldom\package.json" Pack="true" PackagePath="tools/weaver/node_modules/@xmldom/xmldom/" />
    <None Include="..\..\node_modules\@xmldom\xmldom\lib\**" Pack="true" PackagePath="tools/weaver/node_modules/@xmldom/xmldom/lib/" />

    <None Include="..\..\node_modules\chokidar\package.json;..\..\node_modules\chokidar\index.js;..\..\node_modules\chokidar\handler.js" Pack="true" PackagePath="tools/weaver/node_modules/chokidar/" />
    <None Include="..\..\node_modules\chokidar\esm\**\*.js" Pack="true" PackagePath="tools/weaver/node_modules/chokidar/esm/" />

    <None Include="..\..\node_modules\readdirp\package.json;..\..\node_modules\readdirp\index.js" Pack="true" PackagePath="tools/weaver/node_modules/readdirp/" />
    <None Include="..\..\node_modules\readdirp\esm\**\*.js" Pack="true" PackagePath="tools/weaver/node_modules/readdirp/esm/" />

    <None Include="..\..\node_modules\esbuild\package.json;..\..\node_modules\esbuild\install.js" Pack="true" PackagePath="tools/weaver/node_modules/esbuild/" />
    <None Include="..\..\node_modules\esbuild\lib\**" Pack="true" PackagePath="tools/weaver/node_modules/esbuild/lib/" />
    <None Include="..\..\node_modules\esbuild\bin\**" Pack="true" PackagePath="tools/weaver/node_modules/esbuild/bin/" />

    <None Include="..\..\node_modules\@esbuild\win32-x64\package.json" Pack="true" PackagePath="tools/weaver/node_modules/@esbuild/win32-x64/" />
    <None Include="..\..\node_modules\@esbuild\win32-x64\README.md" Pack="true" PackagePath="tools/weaver/node_modules/@esbuild/win32-x64/" />
    <None Include="..\..\node_modules\@esbuild\win32-x64\esbuild.exe" Pack="true" PackagePath="tools/weaver/node_modules/@esbuild/win32-x64/" />

    <None Include="..\..\node_modules\typescript\package.json" Pack="true" PackagePath="tools/weaver/node_modules/typescript/" />
    <None Include="..\..\node_modules\typescript\lib\**\*.js;..\..\node_modules\typescript\lib\**\*.json" Pack="true" PackagePath="tools/weaver/node_modules/typescript/lib/" />
  </ItemGroup>
</Project>